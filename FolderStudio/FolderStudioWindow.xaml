<Window x:Class="Shamsa.FolderStudio.FolderStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="استودیو پوشه نگارخانه"
        Icon="/Shamsa;component/Assets/Shamsa.ico"
        Width="1220" Height="800" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        FlowDirection="RightToLeft"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="StudioPassword" TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource GoldBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13"
                                BorderBrush="#55FFFFFF" BorderThickness="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EmojiBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="2,0,2,8">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" HorizontalAlignment="Left">
                <CheckBox x:Name="ShellIntegrationCheck" Click="ShellIntegration_Click"
                          Content="افزودن گزینه‌های نگارخانه به منوی کلیک‌راست پوشه‌ها و باز شدن فایل‌های قفل با دوبار کلیک"
                          ToolTip="فقط برای حساب کاربری شما (HKCU)، بدون نیاز به دسترسی مدیر و کاملاً قابل برگشت. در ویندوز ۱۱ زیر «Show more options»."/>
            </StackPanel>
            <StackPanel x:Name="HeaderTitle" Orientation="Horizontal">
                <Image Source="/Shamsa;component/Assets/Shamsa-logo.png" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="استودیو پوشه نگارخانه" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"/>
                    <TextBlock Text="آیکون دلخواه برای پوشه‌ها بسازید و پوشه‌های خصوصی را با رمزنگاری AES-256 قفل کنید"
                               Style="{StaticResource Muted}" FontSize="11.5"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <Rectangle Grid.Row="1" Height="1.5" Fill="{DynamicResource PersianDividerBrush}" Margin="0,0,0,10"/>

        <TabControl x:Name="Tabs" Grid.Row="2">
            <!-- ======================= ICONS ======================= -->
            <TabItem Header="🎨 آیکون پوشه">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*" MinWidth="250"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- folders -->
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="۱. پوشه‌ها" Style="{StaticResource SectionTitle}"/>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,8"
                                       Text="پوشه‌ها را از Explorer روی این پنجره بکشید و رها کنید یا دکمه افزودن را بزنید. آیکون روی همه پوشه‌های فهرست اعمال می‌شود."/>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button Content="📁 افزودن پوشه" Click="AddFolder_Click" Margin="0,0,6,6"/>
                                <Button Content="حذف از فهرست" Click="RemoveFolder_Click" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button x:Name="ApplyBtn" Content="🖌 اعمال آیکون روی پوشه‌ها" Click="Apply_Click" Style="{StaticResource GoldButton}" Padding="12,9" Margin="0,0,0,6"/>
                                <Button Content="↺ بازگردانی آیکون پیش‌فرض" ToolTip="آیکون پیش‌فرض ویندوز برای پوشه‌های انتخاب‌شده برمی‌گردد" Click="Restore_Click" Margin="0,0,0,6"/>
                                <TextBlock x:Name="IconStatusText" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/>
                            </StackPanel>
                            <Grid>
                                <ListBox x:Name="FoldersList" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2,4">
                                                <Image Source="{Binding Icon}" Width="34" Height="34" Margin="0,0,8,0" DockPanel.Dock="Left"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" TextAlignment="Right"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{DynamicResource GoldBrush}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="DropHint" Text="📂&#x0a;پوشه‌ها را اینجا رها کنید" TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="13" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- designer -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <Border Style="{StaticResource Card}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="۲. طراحی آیکون" Style="{StaticResource SectionTitle}"/>

                                <TextBlock Text="مدل پوشه" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="FinishPicker" SelectionChanged="Design_Changed" Margin="0,0,0,8">
                                    <ComboBoxItem Content="کلاسیک"/>
                                    <ComboBoxItem Content="شیشهٔ تراش‌خورده"/>
                                    <ComboBoxItem Content="گره‌چینی ایرانی"/>
                                    <ComboBoxItem Content="مینیمال مات"/>
                                </ComboBox>
                                <TextBlock Text="رنگ پایه پوشه" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="BaseSwatches"/>
                                <WrapPanel Margin="0,2,0,0">
                                    <TextBox x:Name="BaseHexBox" Width="110" FlowDirection="LeftToRight" Text="#F4B740"/>
                                    <Button Content="اعمال HEX" Click="BaseHex_Click" Margin="6,0,0,0"/>
                                </WrapPanel>

                                <CheckBox x:Name="GradientCheck" Content="گرادیان با رنگ دوم" ToolTip="رنگ دوم در بالای پوشه" Click="Design_Changed" Margin="0,12,0,4"/>
                                <StackPanel x:Name="GradientPanel" IsEnabled="False">
                                    <WrapPanel x:Name="GradientSwatches"/>
                                    <WrapPanel>
                                        <TextBox x:Name="GradientHexBox" Width="110" FlowDirection="LeftToRight" Text="#FDE68A"/>
                                        <Button Content="اعمال HEX" Click="GradientHex_Click" Margin="6,0,0,0"/>
                                    </WrapPanel>
                                </StackPanel>

                                <TextBlock Text="نماد روی پوشه" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                <WrapPanel>
                                    <RadioButton x:Name="OverlayNone" Content="بدون نماد" GroupName="ov" Margin="0,0,14,0" Foreground="{DynamicResource TextBrush}" Click="Design_Changed" IsChecked="True"/>
                                    <RadioButton x:Name="OverlayEmoji" Content="ایموجی / نماد" GroupName="ov" Margin="0,0,14,0" Foreground="{DynamicResource TextBrush}" Click="Design_Changed"/>
                                    <RadioButton x:Name="OverlayText" Content="متن کوتاه" GroupName="ov" Margin="0,0,14,0" Foreground="{DynamicResource TextBrush}" Click="Design_Changed"/>
                                    <RadioButton x:Name="OverlayImage" Content="تصویر دلخواه" GroupName="ov" Foreground="{DynamicResource TextBrush}" Click="Design_Changed"/>
                                </WrapPanel>

                                <StackPanel x:Name="EmojiPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <WrapPanel x:Name="EmojiButtons" FlowDirection="LeftToRight"/>
                                    <DockPanel Margin="0,4,0,0">
                                        <TextBlock Text="یا ایموجی دلخواه:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="EmojiBox" Width="90" FontFamily="Segoe UI Emoji" FontSize="15" MaxLength="8"
                                                 TextChanged="OverlayInput_Changed" HorizontalAlignment="Left"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                               Text="نکته: WPF ایموجی‌ها را تک‌رنگ رسم می‌کند؛ رنگ نماد را از بخش متن تنظیم کنید یا «خودکار» بگذارید."/>
                                </StackPanel>

                                <StackPanel x:Name="TextPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <WrapPanel>
                                        <TextBox x:Name="OverlayTextBox" Width="120" MaxLength="3" FontSize="15" TextChanged="OverlayInput_Changed"/>
                                        <CheckBox x:Name="BoldCheck" Content="درشت" IsChecked="True" Click="Design_Changed" Margin="10,0,0,0"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" Text="حداکثر ۳ نویسه (حروف فارسی، لاتین یا عدد)."/>
                                </StackPanel>

                                <StackPanel x:Name="InkPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <CheckBox x:Name="AutoInkCheck" Content="رنگ نماد خودکار (کنتراست با پوشه)" IsChecked="True" Click="Design_Changed"/>
                                    <WrapPanel x:Name="InkSwatchesHost">
                                        <WrapPanel x:Name="InkSwatches"/>
                                        <TextBox x:Name="InkHexBox" Width="110" FlowDirection="LeftToRight" Text="#FFFFFF"/>
                                        <Button Content="اعمال" Click="InkHex_Click" Margin="6,0,0,0"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel x:Name="ImagePanel" Visibility="Collapsed" Margin="0,10,0,0">
                                    <DockPanel>
                                        <Button Content="انتخاب تصویر…" Click="PickImage_Click" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                                        <TextBox x:Name="ImagePathBox" Style="{StaticResource PathBox}" IsReadOnly="True"/>
                                    </DockPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <RadioButton x:Name="ImageBadge" Content="نشان روی پوشه" GroupName="im" IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,0" Click="Design_Changed"/>
                                        <RadioButton x:Name="ImageFull" Content="کل آیکون" GroupName="im" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,0" Click="Design_Changed"/>
                                        <RadioButton x:Name="ImageFit" Content="کامل بدون برش" GroupName="im" Foreground="{DynamicResource TextBrush}" Margin="0,0,14,0" Click="Design_Changed"/>
                                        <CheckBox x:Name="RoundedCheck" Content="گوشه‌های گرد" IsChecked="True" Click="Design_Changed"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                               Text="فرمت‌های PNG، JPG، BMP، GIF، TIFF، WEBP و ICO پشتیبانی می‌شوند؛ SVG فعلاً پشتیبانی نمی‌شود. تصویر داخل فایل آیکون جاسازی می‌شود."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- preview + library -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource PersianHighlightCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="FavoriteBtn" Content="☆ علاقه‌مندی" Click="Favorite_Click" DockPanel.Dock="Left" Padding="9,4" FontSize="11.5"/>
                                    <TextBlock Text="پیش‌نمایش زنده" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </DockPanel>
                                <Border CornerRadius="12" Margin="0,10,0,10" Height="156" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1E3A5F" Offset="0"/>
                                            <GradientStop Color="#0B1324" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Image x:Name="BigPreview" Width="144" Height="144" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <UniformGrid Columns="2">
                                    <Border Background="#F1F5F9" CornerRadius="8" Padding="8" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                                            <Image x:Name="P48L" Width="48" Height="48" Margin="0,0,6,0"/>
                                            <Image x:Name="P32L" Width="32" Height="32" Margin="0,0,6,0" VerticalAlignment="Bottom"/>
                                            <Image x:Name="P16L" Width="16" Height="16" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#202020" CornerRadius="8" Padding="8" Margin="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                                            <Image x:Name="P48D" Width="48" Height="48" Margin="0,0,6,0"/>
                                            <Image x:Name="P32D" Width="32" Height="32" Margin="0,0,6,0" VerticalAlignment="Bottom"/>
                                            <Image x:Name="P16D" Width="16" Height="16" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="کتابخانه آیکون" Style="{StaticResource SectionTitle}"/>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <ComboBox x:Name="LibraryFilter" Width="118" DockPanel.Dock="Left" Margin="0,0,6,0" SelectionChanged="Library_Changed">
                                        <ComboBoxItem Content="همه آماده‌ها" IsSelected="True"/>
                                        <ComboBoxItem Content="♥ علاقه‌مندی‌ها"/>
                                        <ComboBoxItem Content="🕘 تاریخچه"/>
                                    </ComboBox>
                                    <TextBox x:Name="LibrarySearch" TextChanged="Library_Changed" ToolTip="جستجو: موسیقی، کد، music، work…"/>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,6,0,0"
                                           Text="کتابخانه محلی و آفلاین نگارخانه (ترکیب رنگ‌ها و موضوع‌ها) — کتابخانه آنلاین اشتراکی نیست."/>
                                <ListBox x:Name="LibraryList" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LibraryList_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="66" Margin="1" ToolTip="{Binding Tip}">
                                                <Image Source="{Binding Preview}" Width="52" Height="52"/>
                                                <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ======================= LOCK ======================= -->
            <TabItem Header="🔒 قفل پوشه">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Border Style="{StaticResource PersianHighlightCard}">
                            <StackPanel>
                                <TextBlock Text="🔐 قفل واقعی با رمزنگاری، نه مخفی‌سازی" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Style="{StaticResource Muted}" LineHeight="20"
                                           Text="پوشه به یک فایل «.shamsalock» کنار خودش تبدیل می‌شود: نام فایل‌ها و محتوا با AES-256-GCM رمز می‌شوند و کلید از رمز شما با PBKDF2-SHA256 (۶۰۰٬۰۰۰ دور) ساخته می‌شود. پیش از حذف پوشه اصلی، فایل قفل یک‌بار کامل رمزگشایی آزمایشی و هش همه فایل‌ها مقایسه می‌شود. رمز فراموش‌شده به هیچ روشی قابل بازیابی نیست."/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="قفل کردن پوشه" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel>
                                        <Button Content="📁" Click="BrowseLockFolder_Click" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                                        <TextBox x:Name="LockFolderBox" Style="{StaticResource PathBox}" TextChanged="LockFolder_Changed"/>
                                    </DockPanel>
                                    <TextBlock x:Name="LockScanText" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0"/>

                                    <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <PasswordBox x:Name="LockPass1" Style="{StaticResource StudioPassword}" PasswordChanged="LockPass_Changed"/>
                                        <TextBox x:Name="LockPass1Plain" Visibility="Collapsed" FlowDirection="LeftToRight" TextChanged="LockPassPlain_Changed"/>
                                    </Grid>
                                    <TextBlock Text="تکرار رمز عبور" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <PasswordBox x:Name="LockPass2" Style="{StaticResource StudioPassword}" PasswordChanged="LockPass_Changed"/>
                                        <TextBox x:Name="LockPass2Plain" Visibility="Collapsed" FlowDirection="LeftToRight" TextChanged="LockPassPlain_Changed"/>
                                    </Grid>
                                    <CheckBox x:Name="ShowPassCheck" Content="نمایش رمز" Click="ShowPass_Click" Margin="0,6,0,0"/>
                                    <ProgressBar x:Name="StrengthBar" Height="6" Maximum="4" Margin="0,8,0,2"/>
                                    <TextBlock x:Name="StrengthText" FontSize="11.5"/>

                                    <TextBlock Text="راهنمای رمز (اختیاری)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="HintBox" MaxLength="120"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                               Text="⚠ راهنما بدون رمزنگاری در فایل ذخیره می‌شود و هر کسی می‌تواند آن را ببیند؛ خود رمز را ننویسید."/>

                                    <Button x:Name="LockBtn" Content="🔒 رمزنگاری و قفل پوشه" Click="Lock_Click" Style="{StaticResource GoldButton}" Padding="12,9" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="بازکردن قفل" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel>
                                        <Button Content="📄" Click="BrowseVault_Click" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                                        <TextBox x:Name="VaultBox" Style="{StaticResource PathBox}" TextChanged="Vault_Changed"/>
                                    </DockPanel>
                                    <TextBlock x:Name="VaultHintText" Foreground="{DynamicResource GoldBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="رمز عبور" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="UnlockPass" Style="{StaticResource StudioPassword}" KeyDown="UnlockPass_KeyDown"/>
                                    <CheckBox x:Name="DeleteVaultCheck" Content="حذف فایل قفل پس از بازکردن موفق" IsChecked="True" Margin="0,10,0,0"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                               Text="پوشه کنار فایل قفل بازیابی می‌شود. اگر پوشه‌ای با همین نام وجود داشته باشد، نام «(unlocked)» می‌گیرد و چیزی بازنویسی نمی‌شود."/>
                                    <Button x:Name="UnlockBtn" Content="🔓 بازکردن قفل" Click="Unlock_Click" Style="{StaticResource AccentButton}" Padding="12,9" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CancelLockBtn" Content="لغو" Click="CancelLock_Click" Style="{StaticResource DangerButton}" DockPanel.Dock="Left" IsEnabled="False" Padding="14,5"/>
                                    <TextBlock x:Name="LockStatusText" Text="آماده" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                </DockPanel>
                                <ProgressBar x:Name="LockProgressBar" Height="8" Maximum="1" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
