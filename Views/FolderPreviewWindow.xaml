<Window x:Class="Shamsa.Views.FolderPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#EE081020"
        BorderThickness="0"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="640" Height="420">
    <!-- Read-only glass card: real DWM acrylic behind a user-tinted layer. Nothing here is clickable. -->
    <Border x:Name="TintLayer" BorderThickness="1" Padding="16,14,16,12">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B0FFFFFF" Offset="0"/>
                <GradientStop Color="#662DD4BF" Offset="0.45"/>
                <GradientStop Color="#88E5B85B" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- light streak across the top edge -->
            <Border Height="1.5" VerticalAlignment="Top" Margin="30,-14,30,0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="54" Height="54" CornerRadius="14" Margin="0,0,12,0"
                        Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Image x:Name="FolderIconImage" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FolderNameText" FontSize="16.5" FontWeight="Bold" Foreground="#F8FAFC"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FolderPathText" FontSize="10.5" Foreground="#AFC3DD" Margin="0,1,0,6"
                               FlowDirection="LeftToRight" TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel x:Name="ChipsPanel"/>
                </StackPanel>
            </DockPanel>

            <!-- gallery hero (media mosaic) -->
            <Grid x:Name="HeroGrid" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed"/>

            <!-- tiles / list -->
            <Grid Grid.Row="2" ClipToBounds="True">
                <WrapPanel x:Name="TilesPanel" Orientation="Horizontal"/>
                <StackPanel x:Name="ListPanel" Visibility="Collapsed"/>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Foreground="#CBD5E1" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,18" TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>

            <!-- footer -->
            <DockPanel Grid.Row="3" Margin="2,10,2,0">
                <TextBlock x:Name="ModifiedText" DockPanel.Dock="Left" FontSize="10.5" Foreground="#94A3B8"/>
                <TextBlock x:Name="MoreText" FontSize="10.5" Foreground="#F6D379" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
