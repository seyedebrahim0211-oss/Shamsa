<Window x:Class="Shamsa.Views.ToolsDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="شمسا (Shamsa) — دستیار هوشمند فایل ویندوز"
        Icon="/Assets/Shamsa.ico"
        Width="1020" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        FlowDirection="LeftToRight"
        StateChanged="Window_StateChanged"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E335A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#284273"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E11D48"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BE123C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarExitAppBtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2A121C"/>
            <Setter Property="Foreground" Value="#FDA4AF"/>
            <Setter Property="BorderBrush" Value="#66F43F5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BE123C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FB7185"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowOuterBorder" BorderBrush="#44E5B85B" BorderThickness="1" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- نوار عنوان اختصاصی شمسا: دکمه‌های ضربدر، بزرگ‌نمایی، کوچک‌نمایی و خروج کامل کاملاً در سمت راست -->
            <Border Grid.Row="0" Background="{DynamicResource GlassHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,0,6,0">
                <DockPanel FlowDirection="LeftToRight" LastChildFill="True">
                    <!-- سمت راست: خروج کامل + کوچک‌نمایی + بزرگ‌نمایی + ضربدر -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="⏻ خروج از برنامه" Click="ExitApp_Click" Style="{StaticResource TitleBarExitAppBtn}"
                                ToolTip="خروج کامل از شمسا و توقف اجرا در پس‌زمینه"/>
                        <Button Content="─" Click="Minimize_Click" Style="{StaticResource TitleBarBtn}" ToolTip="کوچک کردن پنجره"/>
                        <Button x:Name="MaxRestoreBtn" Content="□" Click="MaximizeRestore_Click" Style="{StaticResource TitleBarBtn}" ToolTip="بزرگ‌نمایی / بازگردانی"/>
                        <Button Content="✕" Click="CloseWindow_Click" Style="{StaticResource TitleBarCloseBtn}" FontWeight="Bold"
                                ToolTip="بستن پنجره (برنامه کنار ساعت ویندوز فعال می‌ماند)"/>
                    </StackPanel>

                    <!-- سمت چپ: نشان شمسا + عنوان -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/Shamsa-logo.png" Width="22" Height="22" Margin="2,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="شمسا" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Shamsa" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- بدنه اصلی برنامه (کاملاً فارسی راست‌چین) -->
            <Grid Grid.Row="1" Margin="14,10,14,14" FlowDirection="RightToLeft">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- هدر ایرانی با شمسه هشت‌پر فیروزه و طلا -->
                <DockPanel Margin="2,0,2,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button Content="🧺 قفسه موقت" Click="OpenShelfFromHeader_Click" Style="{StaticResource GoldButton}" Padding="10,5" Margin="0,0,8,0"/>
                        <Border Background="#1D2E4E" BorderBrush="#4410B981" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="● فعال در پس‌زمینه" Foreground="#34D399" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/Shamsa-logo.png" Width="42" Height="42" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="شمسا" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"/>
                                <TextBlock Text=" · دستیار هوشمند مدیریت فایل ویندوز" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                            </StackPanel>
                            <TextBlock Text="پیش‌نمایش شناور ویدیو، منوی دایره‌ای تبدیل فرمت و ابزارهای نظم‌دهی آفلاین" Style="{StaticResource Muted}" FontSize="11.5"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- خط تذهیب جداکننده -->
                <Rectangle Grid.Row="1" Height="1.5" Fill="{DynamicResource PersianDividerBrush}" Margin="0,0,0,10"/>

                <TabControl x:Name="Tabs" Grid.Row="2">

            <!-- ============ Tab 0: راهنمای شروع سریع (برای جلوگیری از سردرگمی کاربر) ============ -->
            <TabItem Header="📖 راهنمای شروع سریع">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <Border Style="{StaticResource PersianHighlightCard}">
                            <DockPanel>
                                <Button Content="✨ آزمایش زنده منوی دایره‌ای" Click="DemoDonut_Click" Style="{StaticResource GoldButton}"
                                        DockPanel.Dock="Left" Padding="14,8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="خوش آمدید! کار با شمسا (Shamsa) در ۳ حرکت ساده" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"/>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                               Text="برنامه بی‌سروصدا کنار ساعت ویندوز (System Tray) آماده است؛ هر وقت روی فایل‌ها کار می‌کنید بدون باز کردن هیچ پنجره‌ای به شما کمک می‌کند."/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,2,0,0">
                            <!-- کارت ۱ -->
                            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="۱. پیش‌نمایش جادویی ویدیو و تصویر 🎬" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" LineHeight="20"
                                               Text="کافی است در File Explorer یا روی دسکتاپ، موس را نیم ثانیه روی هر فایل ویدیویی (MP4، MKV، MOV...) یا تصویر نگه دارید. پیش‌نمایش روان کنار موس باز می‌شود و ویدیو را هوشمندانه مرور می‌کند."/>
                                    <Button Content="⚙️ تنظیم اندازه و سرعت پیش‌نمایش" Click="JumpToSettings_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- کارت ۲ -->
                            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="۲. منوی دایره‌ای تبدیل سریع (مشابه Filee) 🔄" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="GuideDonutDesc" Style="{StaticResource Muted}" LineHeight="20"
                                               Text="دو راه سریع دارید: یا روی فایل شورتکات (پیش‌فرض Alt + Q) را بزنید و گزینه را کلیک کنید، یا Ctrl را نگه دارید و فایل را بکشید. با Tab یا اسکرول موس منو به ابزارهای سریع می‌چرخد."/>
                                    <Button Content="✨ نمایش آزمایشی منوی دایره‌ای" Click="DemoDonut_Click" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- کارت ۳ -->
                            <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="۳. قفسه موقت و نظم‌دهی پوشه‌ها 🧺" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Style="{StaticResource Muted}" LineHeight="20"
                                               Text="فایل‌ها را از چند پوشه مختلف داخل قفسه شناور بیندازید و یکجا به مقصد بکشید یا ZIP کنید. همچنین پوشه شلوغ Downloads را با یک کلیک (و قابلیت بازگردانی کامل) مرتب کنید."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="🧺 باز کردن قفسه موقت" Click="OpenShelfFromHeader_Click" Margin="0,0,6,0"/>
                                        <Button Content="🗂 رفتن به مرتب‌سازی" Click="JumpToOrganizer_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- کارت ۴: وضعیت FFmpeg -->
                            <Border Style="{StaticResource Card}" Margin="6,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="۴. وضعیت موتور تبدیل آفلاین (FFmpeg) ⚡" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="GuideFfmpegStatusText" Style="{StaticResource Muted}" LineHeight="20"
                                               Text="در حال بررسی..."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="GuideInstallFfmpegBtn" Content="⬇ نصب خودکار FFmpeg با یک کلیک" Click="InstallFfmpeg_Click" Style="{StaticResource AccentButton}" Margin="0,0,6,0"/>
                                        <Button Content="🔄 مبدل فایل" Click="JumpToConverter_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="میانبرهای سریع صفحه‌کلید و موس" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="GuideShortcutsText" Style="{StaticResource Muted}" LineHeight="22"
                                           Text="• مکث موس روی فایل ویدیو/تصویر ← نمایش پیش‌نمایش (عمودی/افقی خودکار)    |    • شورتکات روی فایل انتخاب‌شده ← باز شدن منوی دایره‌ای&#x0a;• کلید Tab یا اسکرول موس روی منو ← چرخش به ابزارهای سریع    |    • کلید Esc ← بستن منو یا قفسه"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tab 1: Smart Organizer ============ -->
            <TabItem Header="🗂 مرتب‌سازی هوشمند">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="پوشه‌های شلوغ را دسته‌بندی کنید. فایل‌های سیستمی (desktop.ini) و دانلودهای نیمه‌کاره (.crdownload) دست نمی‌خورند و همه‌چیز قابل بازگردانی است."/>

                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="📁 انتخاب" Click="BrowseOrganizer_Click" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <Button Content="Downloads" Click="OrganizerDownloads_Click" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <Button Content="Desktop" Click="OrganizerDesktop_Click" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                        <ComboBox x:Name="OrganizeModeBox" DockPanel.Dock="Right" Width="170" Margin="10,0,0,0" SelectedIndex="0"
                                  SelectionChanged="OrganizerInput_Changed">
                            <ComboBoxItem Content="بر اساس نوع فایل"/>
                            <ComboBoxItem Content="بر اساس ماه (yyyy-MM)"/>
                            <ComboBoxItem Content="نوع ← سپس ماه"/>
                        </ComboBox>
                        <TextBox x:Name="OrganizerFolderBox" Style="{StaticResource PathBox}" TextChanged="OrganizerInput_Changed"/>
                    </DockPanel>

                    <DataGrid x:Name="OrganizerGrid" Grid.Row="2" IsReadOnly="True" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="فایل" Binding="{Binding FileName}" Width="*" ElementStyle="{StaticResource LtrCell}"/>
                            <DataGridTextColumn Header="پوشه مقصد" Binding="{Binding Category}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="RunOrganizerBtn" Content="✨ شروع مرتب‌سازی" Click="RunOrganizer_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Padding="16,8"/>
                            <Button x:Name="UndoOrganizerBtn" Content="↶ بازگردانی" Click="UndoOrganizer_Click" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="OrganizerStatus" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ Tab 2: Batch Rename ============ -->
            <TabItem Header="✏️ تغییر نام گروهی">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <Button Content="📁 انتخاب پوشه" Click="BrowseRename_Click" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="RenameFolderBox" Style="{StaticResource PathBox}" TextChanged="RenameInput_Changed"/>
                    </DockPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                        <TextBlock Text="پیشوند:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="PrefixBox" Width="90" Margin="0,0,10,4" TextChanged="RenameInput_Changed" FlowDirection="LeftToRight"/>
                        <TextBlock Text="پسوند:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="SuffixBox" Width="90" Margin="0,0,10,4" TextChanged="RenameInput_Changed" FlowDirection="LeftToRight"/>
                        <TextBlock Text="جستجو:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="FindBox" Width="100" Margin="0,0,4,4" TextChanged="RenameInput_Changed" FlowDirection="LeftToRight"/>
                        <TextBlock Text="جایگزین:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="ReplaceBox" Width="100" Margin="0,0,10,4" TextChanged="RenameInput_Changed" FlowDirection="LeftToRight"/>
                        <CheckBox x:Name="RegexCheck" Content="Regex" Margin="0,0,10,4" Checked="RenameInput_Changed" Unchecked="RenameInput_Changed"/>
                        <CheckBox x:Name="MatchCaseCheck" Content="حساس به حروف" IsChecked="True" Margin="0,0,0,4" Checked="RenameInput_Changed" Unchecked="RenameInput_Changed"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <CheckBox x:Name="NumberingCheck" Content="شماره‌گذاری از" Margin="0,0,4,4" Checked="RenameInput_Changed" Unchecked="RenameInput_Changed"/>
                        <TextBox x:Name="NumberStartBox" Width="50" Text="1" Margin="0,0,6,4" TextChanged="RenameInput_Changed" FlowDirection="LeftToRight"/>
                        <TextBlock Text="ارقام:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="NumberPadBox" Width="40" Text="3" Margin="0,0,10,4" TextChanged="RenameInput_Changed" FlowDirection="LeftToRight"/>
                        <TextBlock Text="حروف:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CaseBox" Width="110" SelectedIndex="0" Margin="0,0,10,4" SelectionChanged="RenameInput_Changed">
                            <ComboBoxItem Content="بدون تغییر"/>
                            <ComboBoxItem Content="lowercase"/>
                            <ComboBoxItem Content="UPPERCASE"/>
                            <ComboBoxItem Content="Title Case"/>
                        </ComboBox>
                        <TextBlock Text="فقط پسوندهای:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="ExtFilterBox" Width="110" Margin="0,0,0,4" TextChanged="RenameInput_Changed" FlowDirection="LeftToRight"
                                 ToolTip="مثال: jpg png  (خالی = همه فایل‌ها)"/>
                    </WrapPanel>

                    <DataGrid x:Name="RenamePreviewGrid" Grid.Row="3" IsReadOnly="True" Margin="0,0,0,10">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Unchanged">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نام فعلی" Binding="{Binding OriginalName}" Width="*" ElementStyle="{StaticResource LtrCell}"/>
                            <DataGridTextColumn Header="نام جدید" Binding="{Binding NewName}" Width="*" ElementStyle="{StaticResource LtrCell}"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="ApplyRenameBtn" Content="✓ اعمال تغییر نام" Click="ApplyRename_Click" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Padding="16,8"/>
                            <Button x:Name="UndoRenameBtn" Content="↶ بازگردانی" Click="UndoRename_Click" IsEnabled="False"/>
                        </StackPanel>
                        <TextBlock x:Name="RenameStatusText" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ Tab 3: Duplicates ============ -->
            <TabItem Header="♻️ فایل‌های تکراری">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,8">
                        <Button Content="📁 انتخاب" Click="BrowseDup_Click" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <Button x:Name="ScanDupBtn" Content="🔍 اسکن" Click="ScanDuplicates_Click" Style="{StaticResource AccentButton}" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <Button x:Name="CancelDupBtn" Content="لغو" Click="CancelDup_Click" IsEnabled="False" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                        <TextBox x:Name="DupFolderBox" Style="{StaticResource PathBox}"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <ProgressBar x:Name="DupProgress" Visibility="Collapsed" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DupStatus" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <DataGrid x:Name="DupGrid" Grid.Row="2"
                              Margin="0,0,0,10" MouseDoubleClick="DupGrid_MouseDoubleClick" CanUserSortColumns="False" IsReadOnly="True">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#E5B85B" Margin="6,8,6,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="حذف" Width="50" MinWidth="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="مسیر فایل" Binding="{Binding Path}" Width="*" MinWidth="250" ElementStyle="{StaticResource LtrCell}"/>
                            <DataGridTextColumn Header="تاریخ تغییر" Binding="{Binding ModifiedText}" Width="130" MinWidth="110" ElementStyle="{StaticResource LtrCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="3">
                        <Button Content="انتخاب خودکار (نگه‌داشتن قدیمی‌ترین)" Click="AutoSelectKeepOldest_Click" Margin="0,0,6,4"/>
                        <Button Content="نگه‌داشتن جدیدترین" Click="AutoSelectKeepNewest_Click" Margin="0,0,6,4"/>
                        <Button Content="لغو انتخاب" Click="ClearDupSelection_Click" Margin="0,0,6,4"/>
                        <Button x:Name="DeleteDupBtn" Content="🗑 انتقال انتخاب‌شده‌ها به سطل زباله" Click="DeleteDuplicates_Click" Style="{StaticResource DangerButton}" Margin="0,0,0,4"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ============ Tab 4: Converter & Smart Compression ============ -->
            <TabItem Header="🔄 مبدل و کم‌حجم‌سازی">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- لیست فایل‌ها با نمایش زنده ابعاد و حجم فعلی ← خروجی -->
                    <Border x:Name="ConvertDropZone" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="10"
                            Background="#080F1F" AllowDrop="True" DragOver="ConvertDrop_DragOver" DragLeave="ConvertDrop_DragLeave" Drop="ConvertDrop_Drop">
                        <Grid>
                            <ListBox x:Name="ConvertList" Background="Transparent" BorderThickness="0" Margin="6"
                                     SelectionMode="Extended" FlowDirection="RightToLeft" KeyDown="ConvertList_KeyDown"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0E1A33" BorderBrush="#243B61" BorderThickness="1" CornerRadius="7" Padding="8,6" Margin="0,2">
                                            <DockPanel LastChildFill="True">
                                                <!-- سمت چپ (پایان ردیف RTL): ابعاد و حجم تخمینی/واقعی -->
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <Border Background="#16294A" BorderBrush="#4414B8A6" BorderThickness="1" CornerRadius="5"
                                                            Padding="7,2" Margin="0,0,6,0" Visibility="{Binding DimensionsVisibility}">
                                                        <TextBlock Text="{Binding DimensionsText}" Foreground="#5EEAD4" FontSize="11"
                                                                   FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                                                    </Border>
                                                    <Border Background="#231E12" BorderBrush="#55F6D379" BorderThickness="1" CornerRadius="5"
                                                            Padding="7,2">
                                                        <TextBlock Text="{Binding SizePreviewText}" Foreground="{Binding SizePreviewBrush}" FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- سمت راست (ابتدای ردیف RTL): آیکون و نام فایل -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                                                    <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding FileName}" Foreground="#F8FAFC" FontWeight="SemiBold"
                                                               FontSize="12" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" TextAlignment="Right"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="ConvertEmptyHint" Text="عکس، ویدیو، صوت یا پوشه‌ها را اینجا رها کنید&#x0a;ابعاد دقیق و حجم تخمینی خروجی بلافاصله نمایش داده می‌شود"
                                       Style="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13" LineHeight="22"/>
                        </Grid>
                    </Border>

                    <!-- نوار انتخاب عملیات -->
                    <DockPanel Grid.Row="1" Margin="0,10,0,8">
                        <Button Content="➕ افزودن فایل" Click="AddConvertFiles_Click" Margin="0,0,6,0" DockPanel.Dock="Left"/>
                        <Button Content="پاک کردن لیست" Click="ClearConvertList_Click" Margin="0,0,12,0" DockPanel.Dock="Left"/>
                        <TextBlock Text="عملیات:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ConvertActionBox" Width="250" DockPanel.Dock="Left" SelectionChanged="ConvertActionBox_SelectionChanged"/>
                        <TextBlock x:Name="ConvertSupportText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>

                    <!-- پنل تنظیمات حرفه‌ای کم‌حجم‌سازی (فقط هنگام انتخاب کم‌حجم‌سازی نمایش داده می‌شود) -->
                    <Border x:Name="CompressionPanel" Grid.Row="2" Style="{StaticResource PersianHighlightCard}" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    <TextBlock Text="سطح کیفیت:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CompressPresetBox" Width="175" SelectionChanged="CompressPresetBox_SelectionChanged">
                                        <ComboBoxItem Content="کیفیت بالا (افت نامحسوس)"/>
                                        <ComboBoxItem Content="متعادل و هوشمند (پیشنهادی)"/>
                                        <ComboBoxItem Content="کم‌حجم (تلگرام / وب)"/>
                                        <ComboBoxItem Content="حداکثر فشرده‌سازی"/>
                                        <ComboBoxItem Content="سفارشی (دستی)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    <TextBlock Text="ابعاد خروجی:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CompressResBox" Width="168" SelectionChanged="CompressOption_Changed">
                                        <ComboBoxItem Content="ابعاد اصلی (بدون تغییر)"/>
                                        <ComboBoxItem Content="حداکثر 1920px (Full HD)"/>
                                        <ComboBoxItem Content="حداکثر 1280px (HD)"/>
                                        <ComboBoxItem Content="حداکثر 1024px (وب/موبایل)"/>
                                        <ComboBoxItem Content="حداکثر 720px (کوچک)"/>
                                        <ComboBoxItem Content="۷۵٪ ابعاد اصلی"/>
                                        <ComboBoxItem Content="۵۰٪ ابعاد اصلی"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                                    <TextBlock Text="فرمت عکس:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CompressImgFmtBox" Width="148" SelectionChanged="CompressOption_Changed">
                                        <ComboBoxItem Content="هوشمند (WEBP/JPG)"/>
                                        <ComboBoxItem Content="WEBP (کم‌حجم‌ترین)"/>
                                        <ComboBoxItem Content="JPG (سازگار با همه)"/>
                                        <ComboBoxItem Content="حفظ فرمت اصلی"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="سقف حجم ویدیو:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CompressTargetMbBox" Width="158" SelectionChanged="CompressOption_Changed">
                                        <ComboBoxItem Content="خودکار (بر اساس کیفیت)" Tag="0"/>
                                        <ComboBoxItem Content="زیر 10 MB (دیسکورد/ایمیل)" Tag="10"/>
                                        <ComboBoxItem Content="زیر 25 MB (جیمیل/تلگرام)" Tag="25"/>
                                        <ComboBoxItem Content="زیر 50 MB" Tag="50"/>
                                        <ComboBoxItem Content="زیر 100 MB" Tag="100"/>
                                    </ComboBox>
                                </StackPanel>
                            </WrapPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="درجه کیفیت:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="CompressQualitySlider" Grid.Column="1" Minimum="15" Maximum="95" TickFrequency="5"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                        ValueChanged="CompressQualitySlider_ValueChanged"/>
                                <TextBlock x:Name="CompressQualityText" Grid.Column="2" Foreground="{DynamicResource GoldBrush}"
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,14,0" FlowDirection="LeftToRight"/>
                                <TextBlock x:Name="CompressTotalEstimateText" Grid.Column="3" Foreground="#5EEAD4" FontWeight="SemiBold"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- دکمه‌های اجرا و نوار پیشرفت -->
                    <DockPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="StartConvertBtn" Content="▶ شروع پردازش" Click="StartConvert_Click" Style="{StaticResource AccentButton}" Padding="18,8" Margin="0,0,6,0"/>
                            <Button x:Name="CancelConvertBtn" Content="لغو" Click="CancelConvert_Click" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="ConvertProgress" Maximum="1" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ConvertStatus" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" MouseLeftButtonUp="ConvertStatus_Click" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============ Tab 5: Settings ============ -->
            <TabItem Header="⚙️ تنظیمات">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <!-- Lightweight layered glass; instant preview, persisted in LocalAppData -->
                        <Border Style="{StaticResource PersianHighlightCard}">
                            <StackPanel>
                                <TextBlock Text="✦ ظاهر و تم‌های شیشه‌ای شمسا" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="رنگ‌ها بلافاصله در پنجره‌ها تغییر می‌کنند. تنظیمات برای اجراهای بعدی حفظ می‌شود."
                                           Style="{StaticResource Muted}" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Border Width="42" Height="28" CornerRadius="9" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1" Margin="0,0,7,0"/>
                                    <Border Width="42" Height="28" CornerRadius="9" Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,7,0"/>
                                    <Border Width="42" Height="28" CornerRadius="9" Background="{DynamicResource GoldBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="پیش‌نمایش زنده رنگ‌ها" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                </WrapPanel>
                                <TextBlock Text="انتخاب تم" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="ThemePicker" SelectionChanged="ThemePicker_Changed" MinWidth="250" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <ComboBoxItem Content="فیروزه شب · ایرانی" Tag="PersianTurquoise"/>
                                    <ComboBoxItem Content="لاجورد شیشه‌ای · آبی" Tag="LapisGlass"/>
                                    <ComboBoxItem Content="زمرد · سبز" Tag="EmeraldGlass"/>
                                    <ComboBoxItem Content="آمتیست · بنفش" Tag="AmethystGlass"/>
                                </ComboBox>
                                <TextBlock Text="رنگ تأکیدی دلخواه (اختیاری)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <TextBox x:Name="ThemeAccentBox" Width="140" FlowDirection="LeftToRight" Text="#14B8A6" VerticalContentAlignment="Center"/>
                                    <Button Content="اعمال رنگ" Click="ApplyAccent_Click" Style="{StaticResource AccentButton}" Margin="8,0,8,0"/>
                                    <Button Content="رنگ پیش‌فرض تم" Click="ResetAccent_Click"/>
                                </WrapPanel>
                                <TextBlock x:Name="ThemeAccentError" Foreground="{DynamicResource WarnBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <DockPanel Margin="0,2,0,8">
                                    <TextBlock Text="شفافیت لایه‌های شیشه‌ای" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GlassOpacityLabel" DockPanel.Dock="Right" Width="45" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                    <Slider x:Name="GlassOpacitySlider" Minimum="45" Maximum="97" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="GlassOpacitySlider_Changed" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                                </DockPanel>
                                <CheckBox x:Name="GlassEffectsCheck" Content="گرادیان‌ها و جلوه‌های شیشه‌ای روشن باشند (غیرفعال برای سیستم‌های ضعیف‌تر)"
                                          Click="GlassEffects_Changed"/>
                                <Button Content="بازنشانی ظاهر به حالت اولیه" Click="ResetTheme_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="موتور FFmpeg" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="FfmpegStatusText" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock x:Name="FfmpegPathText" Style="{StaticResource LtrCell}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallFfmpegBtn" Content="⬇ دانلود و نصب خودکار FFmpeg" Click="InstallFfmpeg_Click" Style="{StaticResource AccentButton}" Margin="0,0,6,0"/>
                                    <Button Content="بررسی مجدد" Click="RecheckFfmpeg_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="FfmpegProgressText" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource PersianHighlightCard}">
                            <StackPanel>
                                <TextBlock Text="↻ به‌روزرسانی امن شمسا" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="نسخه‌های جدید از GitHub Releases دریافت می‌شوند. فایل نصب با SHA-256 رسمی مطابقت داده می‌شود؛ نصب تنها با تأیید شما آغاز می‌شود."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <CheckBox x:Name="AutoUpdateCheck" Content="بررسی خودکار نسخه جدید هنگام اجرا و هر ۶ ساعت" Click="Setting_Changed"/>
                                <CheckBox x:Name="AutoDownloadUpdateCheck" Content="دانلود خودکار نسخه جدید در پس‌زمینه (نصب همچنان با تأیید من)" Click="Setting_Changed"/>
                                <TextBlock x:Name="UpdateStatusText" Foreground="{DynamicResource GoldBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,10"/>
                                <WrapPanel>
                                    <Button x:Name="CheckUpdateBtn" Content="بررسی نسخه جدید" Click="CheckUpdate_Click" Margin="0,0,8,5"/>
                                    <Button x:Name="InstallUpdateBtn" Content="دریافت و نصب به‌روزرسانی" Click="InstallUpdate_Click" Style="{StaticResource AccentButton}" Margin="0,0,8,5" IsEnabled="False"/>
                                </WrapPanel>
                                <TextBlock Text="نصب روی سیستم‌های دیگر: بسته ویندوز x64 شامل .NET Desktop Runtime و موتور پخش VLC است. برای تبدیل ویدیو/صدا می‌توانید FFmpeg را با دکمه بالا دریافت کنید؛ اینترنت فقط برای نصب ابزار اختیاری یا به‌روزرسانی نیاز است."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="پیش‌نمایش کنار موس" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="HoverCheck" Content="پیش‌نمایش ویدیو هنگام مکث موس در Explorer و دسکتاپ" Click="Setting_Changed"/>
                                <CheckBox x:Name="PreviewImagesCheck" Content="پیش‌نمایش تصاویر هم نمایش داده شود" Click="Setting_Changed"/>
                                <CheckBox x:Name="FolderPreviewCheck" Content="پیش‌نمایش اسلایدی پوشه‌ها در Explorer و دسکتاپ (حداکثر ۶ تصویر یا ویدیو)" Click="Setting_Changed"/>
                                <TextBlock Text="نمایش سریع فقط از ۱۰۰ مورد اول پوشه؛ بدون بازکردن یا اجرای فایل، پیمایش زیرپوشه، دانلود ابری یا دسترسی به شبکه."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <CheckBox x:Name="SmartScrubCheck" Content="مرور هوشمند ویدیو (پرش خودکار برای دیدن کل محتوا)" Click="Setting_Changed"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="تأخیر نمایش:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="HoverDelayText" DockPanel.Dock="Right" Width="70" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Slider x:Name="HoverDelaySlider" Minimum="40" Maximum="1200" TickFrequency="50" IsSnapToTickEnabled="True"
                                            ValueChanged="HoverDelaySlider_ValueChanged" FlowDirection="LeftToRight"/>
                                </DockPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock Text="اندازه پیش‌نمایش (افقی/عمودی دقیق مطابق فیلم):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PreviewSizeText" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold"
                                                   DockPanel.Dock="Left" Width="62" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                        <Slider x:Name="PreviewSizeSlider" Minimum="150" Maximum="560" TickFrequency="10"
                                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                ValueChanged="PreviewSizeSlider_ValueChanged" FlowDirection="LeftToRight"/>
                                    </DockPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="خیلی کوچک (180)" Tag="180" Click="PreviewSizePreset_Click" Padding="9,3" FontSize="11" Margin="0,0,5,0"/>
                                        <Button Content="کوچک (250)" Tag="250" Click="PreviewSizePreset_Click" Padding="9,3" FontSize="11" Margin="0,0,5,0"/>
                                        <Button Content="متوسط (320)" Tag="320" Click="PreviewSizePreset_Click" Padding="9,3" FontSize="11" Margin="0,0,5,0"/>
                                        <Button Content="بزرگ (420)" Tag="420" Click="PreviewSizePreset_Click" Padding="9,3" FontSize="11" Margin="0,0,5,0"/>
                                        <Button Content="خیلی بزرگ (520)" Tag="520" Click="PreviewSizePreset_Click" Padding="9,3" FontSize="11"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="تبدیل و منوی دایره‌ای" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="DonutCheck" Content="منوی دایره‌ای با Ctrl + کشیدن فایل در Explorer" Click="Setting_Changed"/>
                                <CheckBox x:Name="DonutShortcutCheck" Content="باز کردن منوی دایره‌ای با شورتکات صفحه‌کلید روی فایل انتخاب‌شده یا زیر موس" Click="Setting_Changed"/>

                                <DockPanel Margin="0,8,0,6">
                                    <TextBlock Text="شورتکات منوی دایره‌ای:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="ShortcutBox" Width="170" IsReadOnly="True" Cursor="Hand"
                                             FlowDirection="LeftToRight" TextAlignment="Center" FontWeight="Bold"
                                             Foreground="{DynamicResource GoldBrush}" Margin="0,0,8,0"
                                             GotFocus="ShortcutBox_GotFocus" LostFocus="ShortcutBox_LostFocus"
                                             PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                                             ToolTip="اینجا کلیک کنید و کلید ترکیبی دلخواه (مثلاً Alt + Q یا Ctrl + Shift + D) را فشار دهید"/>
                                    <Button Content="بازنشانی (Alt + Q)" Click="ResetShortcut_Click" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ShortcutStatusText" VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                                </DockPanel>

                                <CheckBox x:Name="DonutAnimCheck" Content="انیمیشن‌های روان باز شدن و چرخش منوی دایره‌ای" Click="Setting_Changed"/>
                                <CheckBox x:Name="RecycleCheck" Content="ارسال فایل اصلی به سطل زباله پس از تبدیل موفق" Click="Setting_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="مرتب‌سازی خودکار" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="AutoOrganizeCheck" Content="فایل‌های جدید این پوشه خودکار دسته‌بندی شوند (پس از اتمام دانلود)" Click="Setting_Changed"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button Content="📁" Click="BrowseAutoOrganize_Click" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                                    <TextBox x:Name="AutoOrganizeFolderBox" Style="{StaticResource PathBox}" LostFocus="AutoOrganizeFolderBox_LostFocus"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="سیستم" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="StartupCheck" Content="اجرای خودکار Shamsa با شروع ویندوز" Click="Startup_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="باز کردن پوشه لاگ" Click="OpenLogs_Click" Margin="0,0,6,0"/>
                                    <Button Content="باز کردن پوشه تنظیمات" Click="OpenDataDir_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
