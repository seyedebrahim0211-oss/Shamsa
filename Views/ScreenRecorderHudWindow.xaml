<Window x:Class="Shamsa.Views.ScreenRecorderHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ضبط صفحه هوشمند | شمسا"
        Width="440" Height="170"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ShamsaFontFamily}">
    <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.2" CornerRadius="18" Padding="14" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="🎥 ضبط صفحه هوشمند شمسا (سبک Bandicam)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center"/>
                <Button Content="✕" DockPanel.Dock="Left" Click="Close_Click" Width="26" Height="26" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="RecordBtn" Content="⏺ شروع ضبط" Click="ToggleRecord_Click" Padding="14,7" Margin="0,0,8,0" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="📸 اسکرین‌شات" Click="Screenshot_Click" Padding="12,7" Margin="0,0,8,0" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                <ComboBox x:Name="FpsCombo" Width="82" SelectedIndex="1" VerticalContentAlignment="Center" Margin="0,0,8,0">
                    <ComboBoxItem Content="24 FPS"/>
                    <ComboBoxItem Content="30 FPS"/>
                    <ComboBoxItem Content="60 FPS"/>
                </ComboBox>
                <ComboBox x:Name="QualityCombo" Width="92" SelectedIndex="2" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Lossless"/>
                    <ComboBoxItem Content="High"/>
                    <ComboBoxItem Content="Balanced"/>
                    <ComboBoxItem Content="Compact"/>
                </ComboBox>
            </StackPanel>

            <DockPanel Grid.Row="2">
                <TextBlock x:Name="StatusLabel" Text="آماده ضبط • فرمان صوتی: «شروع ضبط» / «اسکرین شات»" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <Button Content="📂 پوشه ضبط‌ها" DockPanel.Dock="Left" Click="OpenFolder_Click" Padding="8,4" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
