<Window x:Class="Shamsa.Views.GlassFolderPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پیش‌نمایش شیشه‌ای پوشه | نگارخانه"
        Width="720" Height="480"
        MinWidth="460" MinHeight="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ShamsaFontFamily}"
        Topmost="True">
    <Border x:Name="GlassRoot"
            Background="{DynamicResource GlassCardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.2"
            CornerRadius="20"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="24" Margin="0,0,0,0"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock x:Name="FolderTitleText" Text="نام پوشه" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock x:Name="FolderStatsText" Text="در حال بررسی محتویات..." FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="تغییر آیکون / قفل" Click="CustomizeFolder_Click" Margin="4,0" Padding="10,5" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                    <Button Content="باز کردن" Click="OpenInExplorer_Click" Margin="4,0" Padding="10,5" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                    <Button Content="✕" Click="Close_Click" Margin="4,0" Width="30" Height="30" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>

            <!-- Search & Glass Customization Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="SearchBox_TextChanged"
                         Padding="10,6" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" ToolTip="جستجو در فایل‌های پوشه"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="شفافیت:" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,6,0"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.45" Maximum="0.98" Value="0.88" Width="85" ValueChanged="OpacitySlider_ValueChanged"/>
                </StackPanel>
            </Grid>

            <!-- Split Content: Folder Items + Office/PDF/Media First-Page Preview -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="ItemsList" Grid.Column="0"
                         Background="{DynamicResource SurfaceBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         SelectionChanged="ItemsList_SelectionChanged"
                         MouseDoubleClick="ItemsList_DoubleClick"/>

                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10">
                    <DockPanel>
                        <TextBlock x:Name="PreviewTitleText" DockPanel.Dock="Top" Text="پیش‌نمایش فایل (آفیس، PDF، عکس)" FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                        <Image x:Name="PreviewImage" DockPanel.Dock="Top" MaxHeight="200" Stretch="Uniform" Margin="0,0,0,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewSnippetText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <TextBlock Grid.Row="3" x:Name="FooterHintText" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       Text="برای پیش‌نمایش صفحه اول ورد، اکسل، پاورپوینت و PDF روی هر فایل کلیک کنید • پنجره قابل تغییر اندازه است"/>
        </Grid>
    </Border>
</Window>
