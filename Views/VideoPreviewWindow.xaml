<Window x:Class="Shamsa.Views.VideoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#EE081020"
        BorderThickness="0"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Width="338" Height="245">
    <!-- AllowsTransparency=False با شیشه مات بومی DWM Acrylic ویندوز ۱۰/۱۱ تا LibVLC با حداکثر سرعت رندر شود -->

    <Window.Resources>
        <!-- نوار پیشرفت شیشه‌ای و ظریف فیروزه-طلایی -->
        <Style x:Key="GlassScrubBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" Background="#38FFFFFF" CornerRadius="1.5"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="1.5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2DD4BF" Offset="0"/>
                                        <GradientStop Color="#5EEAD4" Offset="0.55"/>
                                        <GradientStop Color="#F6D379" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- قاب شیشه‌ای مات چندلایه با حاشیه براق کریستالی و بازتاب نور بالایی -->
    <Border x:Name="OuterGlassBorder" CornerRadius="8" BorderThickness="1" Padding="7">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C0D1A33" Offset="0"/>
                <GradientStop Color="#96081224" Offset="0.52"/>
                <GradientStop Color="#AC060C1A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#A8FFFFFF" Offset="0"/>
                <GradientStop Color="#882DD4BF" Offset="0.42"/>
                <GradientStop Color="#AAE5B85B" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- بازتاب نور شیشه‌ای بالای قاب (کاملاً خارج از ناحیه ویدیو بدون تداخل رندر) -->
            <Border Grid.Row="0" Height="1.5" VerticalAlignment="Top" Margin="10,-7,10,0" CornerRadius="1" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#88FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- قاب دقیق رسانه (ابعاد این کادر دقیقاً برابر نسبت تصویر واقعی فیلم یا عکس تنظیم می‌شود تا هیچ نوار سیاهی نباشد) -->
            <Border x:Name="MediaFrame" Grid.Row="0" BorderThickness="1" Background="#050914" ClipToBounds="True">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                        <GradientStop Color="#552DD4BF" Offset="0.5"/>
                        <GradientStop Color="#55E5B85B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <vlc:VideoView x:Name="VlcVideoView" IsHitTestVisible="False" Visibility="Hidden"/>
                    <Image x:Name="ImagePreview" Stretch="Uniform" Visibility="Collapsed"
                           IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Border>

            <!-- نوار پیشرفت شیشه‌ای (ارتفاع دقیق 3 + حاشیه 5 = 8px) -->
            <ProgressBar x:Name="ScrubBar" Grid.Row="1" Style="{StaticResource GlassScrubBar}"
                         Margin="0,5,0,0" FlowDirection="LeftToRight" Visibility="Collapsed"/>

            <!-- نوار اطلاعات شیشه‌ای پایین با ارتفاع دقیق ثابت 34px + حاشیه 5 = 39px -->
            <Grid x:Name="FooterGrid" Grid.Row="2" Height="34" Margin="2,5,2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="16"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Ellipse x:Name="MediaTypeDot" Width="6" Height="6" Fill="#2DD4BF"
                             DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,1,0,0"/>
                    <TextBlock x:Name="FileNameText" Foreground="#F8FAFC" FontSize="11"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" FlowDirection="LeftToRight" TextAlignment="Right"/>
                </DockPanel>

                <TextBlock x:Name="FileInfoText" Grid.Row="1" Foreground="#F6D379" FontSize="10"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" FlowDirection="LeftToRight" TextAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
