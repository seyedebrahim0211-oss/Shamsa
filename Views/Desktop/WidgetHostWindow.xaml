<Window x:Class="Shamsa.Views.Desktop.WidgetHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ویجت‌های هوشمند شمسا"
        Width="310" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ShamsaFontFamily}">
    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="6">
            <!-- Persian Calendar & Clock Widget -->
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,10" MouseLeftButtonDown="DragCard_MouseDown">
                <StackPanel>
                    <TextBlock x:Name="ClockBigText" Text="00:00" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"/>
                    <TextBlock x:Name="JalaliDateText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="AltDatesText" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="OccasionText" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Prayer Times Widget -->
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="PrayerHeaderText" Text="🕌 اوقات شرعی" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="PrayerBodyText" FontSize="12" Foreground="{DynamicResource TextBrush}" LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- Weather & System Telemetry Widget -->
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="💻 وضعیت سیستم و شبکه" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TelemetryWidgetText" FontSize="11.5" Foreground="{DynamicResource TextBrush}" LineHeight="19"/>
                </StackPanel>
            </Border>

            <!-- Sticky Note Widget -->
            <Border Background="{DynamicResource GlassCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                <StackPanel>
                    <TextBlock Text="📝 یادداشت چسبان" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="StickyNoteBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" Padding="8" TextChanged="StickyNoteBox_TextChanged"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
