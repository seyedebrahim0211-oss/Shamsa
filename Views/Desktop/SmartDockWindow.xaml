<Window x:Class="Shamsa.Views.Desktop.SmartDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="داک هوشمند شمسا"
        Height="74"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ShamsaFontFamily}">
    <Border Background="{DynamicResource GlassCardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1.2"
            CornerRadius="22"
            Padding="12,8"
            Margin="6">
        <StackPanel x:Name="DockItemsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
    </Border>
</Window>
