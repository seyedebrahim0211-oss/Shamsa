<Window x:Class="Shamsa.Views.Desktop.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نوار بالا و مرکز کنترل نگارخانه"
        Height="38"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ShamsaFontFamily}">
    <Border Background="{DynamicResource GlassHeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Right (RTL start): Brand + Workspaces + Tiling Quick Switch -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🖼 نگارخانه" Click="OpenHub_Click" Padding="10,4" Background="{DynamicResource PersianBadgeBrush}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" BorderThickness="0" Margin="0,0,8,0"/>
                <ComboBox x:Name="WorkspaceCombo" Width="130" SelectionChanged="WorkspaceCombo_SelectionChanged" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="⊞ چیدمان ۲ ستونه" Click="TileTwoCol_Click" Padding="8,4" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Margin="0,0,4,0"/>
                <Button Content="🎥 ضبط" Click="OpenRecorder_Click" Padding="8,4" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Margin="0,0,4,0"/>
                <Button Content="🔍 جستجو" Click="OpenSpotlight_Click" Padding="8,4" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                <StackPanel x:Name="PluginSlotPanel" Orientation="Horizontal" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Center: Jalali Date & Clock -->
            <TextBlock x:Name="ClockDateText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>

            <!-- Left (RTL end): Control Center Quick Toggles -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TelemetryMiniText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0"/>
                <Button Content="📶 وای‌فای" Click="OpenWifiSettings_Click" Padding="6,4" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                <Button Content="ᛒ بلوتوث" Click="OpenBluetoothSettings_Click" Padding="6,4" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                <Button Content="🌙 نور شب" Click="OpenNightLightSettings_Click" Padding="6,4" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                <Button Content="🔕 مزاحم نشوید" Click="OpenDndSettings_Click" Padding="6,4" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                <Button Content="☀ روشنایی" Click="OpenDisplaySettings_Click" Padding="6,4" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"/>
                <Button Content="⚙" Click="OpenHub_Click" Padding="8,4" Background="Transparent" Foreground="{DynamicResource AccentBrush}" FontSize="14" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
